  "domains": {
    "phone": {
      "metrics": [
        {
          "id": "mp",
          "label": "名义像素 (MP)",
          "definition": "厂商标注相机名义像素，不是MTF或有效细节。",
          "conditions": "模组、输出模式、合并/裁切条件",
          "numeric": true
        },
        {
          "id": "f",
          "label": "最大光圈 F 数",
          "definition": "原厂最大光圈对应的F数；几何定义N=f/D_eff为真实焦距与有效孔径直径之比，无量纲。可变光圈保留档位；有限共轭需区分工作F数。F数不等于透光率或画质分数。",
          "conditions": "真实模组与光圈档位；较小值不等于更好成像",
          "numeric": true,
          "definition_refs": [
            {
              "source": "edmund_fnumber_20261114",
              "location": "§2.1 Eq.1；f/# Changes with a Working Distance Change / Eq.2"
            }
          ]
        },
        {
          "id": "focal",
          "label": "厂商标注焦段 (mm)",
          "definition": "所读页面的焦段值；未声称物理焦距，未核等效口径不可用于入瞳计算。 物理有效焦距应从相应主平面计，不能把镜片后表面/工作距离当参考面；厂商等效焦段不是可代入N=f/D的真实焦距。该字段仍沿用厂商口径，未核者保留缺口。",
          "conditions": "等效/物理口径需要补证",
          "numeric": true,
          "definition_refs": [
            {
              "source": "tudelft_principal_planes_20261114",
              "location": "The Thick Lens，Fig.32–34对应正文"
            }
          ]
        },
        {
          "id": "fov",
          "label": "视场角 (°，方向未明)",
          "definition": "厂家给出角度但未说明水平/垂直/对角。",
          "conditions": "同方向、裁切与输出模式后方可比较",
          "numeric": true
        },
        {
          "id": "sensor",
          "label": "传感器光学格式",
          "definition": "光学格式字符串不是实际对角线英寸。",
          "conditions": "不得据格式反推精确面积",
          "numeric": false
        },
        {
          "id": "sfr",
          "label": "SFR / MTF",
          "definition": "空间频率响应；待收实验曲线或指定频率处响应。",
          "conditions": "频率单位、场点、方向、波长、RAW/JPEG、锐化",
          "numeric": true
        },
        {
          "id": "dr",
          "label": "动态范围 (EV)",
          "definition": "待收具有明确噪声阈值的系统动态范围。",
          "conditions": "ISO、曝光、SNR阈值、HDR/单帧、处理",
          "numeric": true
        },
        {
          "id": "snr",
          "label": "信噪比 (dB)",
          "definition": "待收场景亮度和处理明确的成像信噪比。",
          "conditions": "照度、ISO、曝光、区域、算法",
          "numeric": true
        },
        {
          "id": "distortion",
          "label": "畸变 (%)",
          "definition": "待收镜头原生与软件校正后的畸变。",
          "conditions": "场高、畸变定义、裁切、校正状态",
          "numeric": true
        },
        {
          "id": "ca",
          "label": "横向色差 (px)",
          "definition": "待收不同颜色通道像点位移。",
          "conditions": "场点、焦距、对焦、输出尺寸、处理",
          "numeric": true
        },
        {
          "id": "flare",
          "label": "眩光 / 鬼像",
          "definition": "待收点光源及杂散光条件下的测量结果。",
          "conditions": "光源角度、曝光、照度、定义",
          "numeric": true
        },
        {
          "id": "af",
          "label": "自动对焦支持（标称）",
          "definition": "本字段只记录原厂是否明确标注AF支持；不代表对焦速度、精度、追焦成功率或全部拍摄模式。",
          "conditions": "模组、拍摄模式与厂商原文；未列明不能写成不支持",
          "numeric": false,
          "definition_refs": [
            {
              "source": "oppo_x10_pro_max_global_20261114",
              "location": "Camera / Rear，AF supported"
            }
          ]
        },
        {
          "id": "ois",
          "label": "光学防抖支持（标称）",
          "definition": "记录原厂明确的OIS支持及轴数；不替代稳定性增益、视频电子防抖或运动场景实测。",
          "conditions": "模组、拍摄模式与厂商原文；未列明不能写成不支持",
          "numeric": false,
          "definition_refs": [
            {
              "source": "oppo_x10_pro_max_global_20261114",
              "location": "Camera / Rear，Supports 2-axis OIS"
            }
          ]
        }
      ],
