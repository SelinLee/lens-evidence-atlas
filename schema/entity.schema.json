{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lens evidence entities",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "definition_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "ranking_status": {
      "enum": [
        "not_established",
        "editorial_synthesis",
        "author_explicit"
      ]
    },
    "checked_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
